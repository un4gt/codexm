{
  "expo": {
    "name": "codexm",
    "slug": "codexm",
    "version": "0.0.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "codexm",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": "0.0.7",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "package": "com.unsafe.codexm"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      "expo-dev-client",
      "./plugins/withNdkPkgPrefabRepo",
      "./plugins/withExtractNativeLibs",
      "./plugins/withLegacyPackaging",
      "./plugins/withIgnoreCodexAssets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "12707eeb-9d30-4fdd-8cd5-96b23070a6cb"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/12707eeb-9d30-4fdd-8cd5-96b23070a6cb",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
